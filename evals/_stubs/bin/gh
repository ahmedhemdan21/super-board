#!/usr/bin/env bash
# Offline `gh` stand-in for evals. Reads fixtures from <repo>/.git/gh-fixture/ (out of
# the agent's sight in `ls`), logs every call to <repo>/.gh-log (shell-quoted) and
# <repo>/.git/gh-calls.log (plain, one call per line), and never touches the network.
# `pr merge` is a logged no-op.
# Fixtures: pr.json (the `gh pr view --json` object, incl. comments), diff.patch, and
# optionally issue.json (the `gh issue view --json` object; without it a cart-discount issue).
# super-collect cases add, each optional:
#   issues.json        `gh issue list` / `issue view <n>` — array of {number,title,body,state,labels,url}
#   prs-merged.json    `gh pr list` — array of merged PRs (used instead of pr.json when present)
#   project-items.json `gh project item-list` — {items:[…], totalCount}
#   fields.json        `gh project field-list` (default: Status = Backlog, Ready, In progress, Done)
#   graphql.json       `gh api graphql` for anything but a rateLimit or issue-history query (collect_prs.py's search)
#   issues.json also answers the filers' issue-history query, as one complete page.
# List reads honour --state, --label and --search (any search word of 5+ letters in title or
# body). Writes are recorded, never sent: `issue create` appends its body to
# .git/gh-created.md and answers a new issue URL; `issue comment` appends to .git/gh-comments.md.
set -uo pipefail
ROOT="$PWD"
while [ "$ROOT" != / ] && [ ! -d "$ROOT/.git" ]; do ROOT="$(dirname "$ROOT")"; done
[ -d "$ROOT/.git" ] || ROOT="$PWD"
FX="$ROOT/.git/gh-fixture"
LOG="$ROOT/.gh-log"
printf '%q ' gh "$@" >>"$LOG"; echo >>"$LOG"
[ -d "$ROOT/.git" ] && printf '%s\n' "gh $*" >>"$ROOT/.git/gh-calls.log"

jq_arg="" json_fields="" state_arg="" label_arg="" search_arg="" body_arg="" body_file="" title_arg=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[$i]}" in
    --jq|-q) jq_arg="${args[$((i + 1))]:-}" ;;
    --jq=*) jq_arg="${args[$i]#--jq=}" ;;
    --json) json_fields="${args[$((i + 1))]:-}" ;;
    --json=*) json_fields="${args[$i]#--json=}" ;;
    --state|-s) state_arg="${args[$((i + 1))]:-}" ;;
    --label|-l) label_arg="${args[$((i + 1))]:-}" ;;
    --search|-S) search_arg="${args[$((i + 1))]:-}" ;;
    --body|-b) body_arg="${args[$((i + 1))]:-}" ;;
    --body-file) body_file="${args[$((i + 1))]:-}" ;;
    --title|-t) title_arg="${args[$((i + 1))]:-}" ;;
  esac
done

emit() { # emit <json>: apply --json field selection, then --jq
  local data="$1"
  if [ -n "$json_fields" ]; then
    data=$(jq -c --arg f "$json_fields" '. as $o | ($f | split(",")) | map({(.): $o[.]}) | add' <<<"$data")
  fi
  if [ -n "$jq_arg" ]; then jq -r "$jq_arg" <<<"$data"; else jq . <<<"$data"; fi
}

emit_list() { # emit_list <json array>: per-item --json selection, then --jq
  local data="$1"
  if [ -n "$json_fields" ]; then
    data=$(jq -c --arg f "$json_fields" '[.[] | . as $o | ($f | split(",")) | map({(.): $o[.]}) | add]' <<<"$data")
  fi
  if [ -n "$jq_arg" ]; then jq -r "$jq_arg" <<<"$data"; else jq . <<<"$data"; fi
}

filtered() { # filtered <file>: the array narrowed by --state / --label / --search
  jq -c --arg state "$(echo "$state_arg" | tr '[:upper:]' '[:lower:]')" --arg label "$label_arg" --arg search "$search_arg" '
    ($search | ascii_downcase | gsub("[^a-z0-9: ]"; " ") | split(" ")
      | map(select(length >= 5 and (contains(":") | not)))) as $w
    | [ .[]
        | select($state == "" or $state == "all" or ((.state // "open") | ascii_downcase) == $state)
        | select($label == "" or ([.labels[]?.name] | index($label)) != null)
        | select(($w | length) == 0 or
            ((((.title // "") + " " + (.body // "")) | ascii_downcase) as $t | any($w[]; . as $x | $t | contains($x)))) ]' "$1"
}

record() { # record <file> <heading>: append one written body
  { echo "=== $2"
    if [ -n "$body_file" ] && [ -r "$body_file" ]; then cat "$body_file"; else printf '%s\n' "$body_arg"; fi
    echo; } >>"$ROOT/.git/$1"
}

RATE='{"resources":{"core":{"limit":5000,"used":12,"remaining":4988,"reset":4102444800},"graphql":{"limit":5000,"used":12,"remaining":4988,"reset":4102444800}}}'

case "${1:-} ${2:-}" in
  "auth status"*) echo "Logged in to github.com (eval stub)" ;;
  "pr view"*) emit "$(cat "$FX/pr.json")" ;;
  "pr list"*)
    if [ -f "$FX/prs-merged.json" ]; then
      case "$(echo "$state_arg" | tr '[:upper:]' '[:lower:]')" in ""|merged|all|closed) state_arg="" ;; *) state_arg="none" ;; esac
      emit_list "$(filtered "$FX/prs-merged.json")"
    else emit "[$(cat "$FX/pr.json")]"; fi ;;
  "pr diff"*) cat "$FX/diff.patch" ;;
  "pr checks"*) echo "no checks reported (eval stub)" ;;
  "pr merge"*) echo "merge recorded, not performed (eval stub)" ;;
  "issue list"*) if [ -f "$FX/issues.json" ]; then emit_list "$(filtered "$FX/issues.json")"; else emit_list '[]'; fi ;;
  "issue create"*)
    n=$(( 500 + $(cat "$ROOT/.git/gh-created.md" 2>/dev/null | grep -c '^=== ') ))
    record gh-created.md "#$n $title_arg"
    echo "https://github.com/example/shop/issues/$n" ;;
  "issue comment"*) record gh-comments.md "#${3:-?}"; echo "ok (eval stub)" ;;
  "pr comment"*|"pr review"*|"pr edit"*|"pr ready"*|"issue edit"*) echo "ok (eval stub)" ;;
  "issue view"*)
    if [ -f "$FX/issue.json" ]; then emit "$(cat "$FX/issue.json")"
    elif [ -f "$FX/issues.json" ] && jq -e --argjson n "${3//[!0-9]/}" 'any(.[]; .number == $n)' "$FX/issues.json" >/dev/null 2>&1; then
      emit "$(jq --argjson n "${3//[!0-9]/}" '.[] | select(.number == $n)' "$FX/issues.json")"
    elif [ -f "$FX/pr.json" ]; then emit "$(jq '{number: 7, title: .title, body: "Cart discount. AC: discount percent is clamped to 0-100; an empty cart totals 0.", labels: [], comments: []}' "$FX/pr.json")"
    else echo "GraphQL: Could not resolve to an issue with the number of ${3:-?}. (eval stub)" >&2; exit 1; fi ;;
  "repo view"*) emit '{"name":"shop","nameWithOwner":"example/shop","owner":{"login":"example"},"url":"https://github.com/example/shop"}' ;;
  "project list"*) emit '{"projects":[{"number":1,"title":"Shop","url":"https://github.com/users/example/projects/1","id":"PVT_eval"}],"totalCount":1}' ;;
  "project view"*) emit '{"id":"PVT_eval","number":1,"title":"Shop","url":"https://github.com/users/example/projects/1"}' ;;
  "project item-list"*) if [ -f "$FX/project-items.json" ]; then emit "$(cat "$FX/project-items.json")"; else emit '{"items":[],"totalCount":0}'; fi ;;
  "project field-list"*)
    if [ -f "$FX/fields.json" ]; then emit "$(cat "$FX/fields.json")"
    else emit '{"fields":[{"id":"PVTSSF_status","name":"Status","type":"ProjectV2SingleSelectField","options":[{"id":"opt_backlog","name":"Backlog"},{"id":"opt_ready","name":"Ready"},{"id":"opt_progress","name":"In progress"},{"id":"opt_done","name":"Done"}]}],"totalCount":1}'; fi ;;
  "project item-add"*) emit '{"id":"PVTI_eval_new"}' ;;
  "project item-edit"*|"label create"*) echo "ok (eval stub)" ;;
  "api rate_limit"*) emit "$RATE" ;;
  "api graphql")
    case "$*" in
      *rateLimit*) emit '{"data":{"rateLimit":{"limit":5000,"remaining":4988,"used":12,"resetAt":"2099-12-31T00:00:00Z"}}}' ;;
      *"issues(first:"*) # the filers' complete issue history (--paginate --slurp): one page from issues.json
        jq -c '[{data: {repository: {issues: {totalCount: length, pageInfo: {hasNextPage: false, endCursor: null},
                 nodes: [.[] | {number, state: (.state | ascii_upcase), body: (.body // "")}]}}}}]' \
          "$( [ -f "$FX/issues.json" ] && echo "$FX/issues.json" || echo /dev/stdin)" <<<'[]' ;;
      *) if [ -f "$FX/graphql.json" ]; then emit "$(cat "$FX/graphql.json")"; elif [ -n "$jq_arg" ]; then echo '{}' | jq -r "$jq_arg" 2>/dev/null; else echo '{}'; fi ;;
    esac ;;
  "api "*) if [ -n "$jq_arg" ]; then echo '{}' | jq -r "$jq_arg" 2>/dev/null; else echo '{}'; fi ;;
  *) echo "ok (eval stub)" ;;
esac
exit 0
